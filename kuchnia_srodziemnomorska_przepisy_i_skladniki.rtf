\b 2) Salatka grecka (2 porcje)\b0\par
\b Skladniki:\b0\par
- 2 pomidory\par
- 1 ogorek\par
- 1/2 czerwonej cebuli\par
- 1 zielona papryka\par
- 120 g sera feta\par
- 10-12 oliwek kalamata\par
- 3 lyzki oliwy extra virgin\par
- 1 lyzka soku z cytryny\par
- oregano, sol, pieprz\par
\b Przygotowanie:\b0\par
1. Pokroj warzywa w duze kawalki.\par
2. Dodaj oliwki i fete.\par
3. Polej oliwa i sokiem z cytryny, dopraw oregano.\par
4. Delikatnie wymieszaj i podawaj od razu.\par
\par
\b 3) Bruschetta al pomodoro (8 kromek)\b0\par
\b Skladniki:\b0\par
- 1 bagietka lub chleb ciabatta\par
- 3 dojrzale pomidory\par
- 2 zabki czosnku\par
- 3 lyzki oliwy extra virgin\par
- garsc swiezej bazylii\par
- sol i pieprz\par
\b Przygotowanie:\b0\par
1. Kromki pieczywa podpiecz na chrupiaco.\par
2. Natrzyj je czosnkiem.\par
3. Pomidory pokroj w kostke, wymieszaj z oliwa, bazylia i przyprawami.\par
4. Naloz pomidory na pieczywo i podawaj.\par
\par
\b 4) Gazpacho (3-4 porcje)\b0\par
\b Skladniki:\b0\par
- 700 g pomidorow\par
- 1 ogorek\par
- 1/2 czerwonej papryki\par
- 1 maly zabek czosnku\par
- 2 lyzki oliwy extra virgin\par
- 1 lyzka octu winnego\par
- 1 kromka chleba (opcjonalnie)\par
- sol i pieprz\par
\b Przygotowanie:\b0\par
1. Pokroj warzywa i zblenduj je na gladko.\par
2. Dodaj oliwe, ocet, przyprawy i ponownie zblenduj.\par
3. Schlodz minimum 1 godzine.\par
4. Podawaj bardzo zimne.\par
\par
\b 5) Ratatouille (3 porcje)\b0\par
\b Skladniki:\b0\par
- 1 baklazan\par
- 1 cukinia\par
- 1 czerwona papryka\par
- 1 cebula\par
- 2 zabki czosnku\par
- 400 g krojonych pomidorow\par
- 3 lyzki oliwy\par
- tymianek, bazylia, sol, pieprz\par
\b Przygotowanie:\b0\par
1. Warzywa pokroj w kostke.\par
2. Podsmaz cebule i czosnek, dodaj reszte warzyw.\par
3. Dodaj pomidory i ziola.\par
4. Dus 30-35 minut do miekkosci.\par
\par
\b 6) Dorsz pieczony z cytryna i oliwkami (2 porcje)\b0\par
\b Skladniki:\b0\par
- 2 filety dorsza (ok. 350-400 g)\par
- 1 cytryna\par
- 2 lyzki oliwy\par
- 2 zabki czosnku\par
- 12 czarnych oliwek\par
- 8 pomidorkow koktajlowych\par
- pietruszka, sol, pieprz\par
\b Przygotowanie:\b0\par
1. Uloz dorsza w naczyniu, skrop oliwa i sokiem z pol cytryny.\par
2. Dodaj czosnek, oliwki i pomidorki.\par
3. Piecz 15-18 minut w 200 C.\par
4. Posyp pietruszka i podawaj z ryzem lub salata.\par
\par
\b 7) Krewetki saganaki (2 porcje)\b0\par
\b Skladniki:\b0\par
- 300 g obranych krewetek\par
- 1 mala cebula\par
- 2 zabki czosnku\par
- 200 g passaty pomidorowej\par
- 80 g sera feta\par
- 2 lyzki oliwy\par
- 1/2 lyzeczki chili (opcjonalnie)\par
- oregano, sol, pieprz\par
\b Przygotowanie:\b0\par
1. Podsmaz cebule i czosnek na oliwie.\par
2. Dodaj passate i przyprawy, gotuj 8 minut.\par
3. Dodaj krewetki i gotuj 3-4 minuty.\par
4. Posyp feta i podawaj z pieczywem.\par
\par
\b 8) Spaghetti aglio e olio z krewetkami (2 porcje)\b0\par
\b Skladniki:\b0\par
- 180 g spaghetti\par
- 220 g krewetek\par
- 4 lyzki oliwy extra virgin\par
- 3 zabki czosnku\par
- 1/2 lyzeczki chili lub platkow chili\par
- pietruszka\par
- sol i pieprz\par
\b Przygotowanie:\b0\par
1. Ugotuj makaron al dente.\par
2. Na oliwie podsmaz czosnek i chili.\par
3. Dodaj krewetki i smaz 2-3 minuty.\par
4. Wymieszaj z makaronem i odrobina wody z gotowania.\par
\par
\b 9) Kurczak souvlaki (3 porcje)\b0\par
\b Skladniki:\b0\par
- 500 g filetu z kurczaka\par
- 3 lyzki oliwy\par
- 1 lyzka soku z cytryny\par
- 2 zabki czosnku\par
- 1 lyzeczka oregano\par
- 1/2 lyzeczki slodkiej papryki\par
- sol i pieprz\par
\b Przygotowanie:\b0\par
1. Kurczaka pokroj w kostke i wymieszaj z marynata.\par
2. Odstaw na minimum 30 minut.\par
3. Nadziewaj na patyczki i grilluj lub piecz 12-15 minut.\par
4. Podawaj z pita i tzatziki.\par
\par
\b 10) Paella marinera (uproszczona, 3 porcje)\b0\par
\b Skladniki:\b0\par
- 250 g ryzu do paelli lub arborio\par
- 250 g mieszanki owocow morza\par
- 200 g krewetek\par
- 1 cebula\par
- 1/2 czerwonej papryki\par
- 2 zabki czosnku\par
- 700 ml bulionu\par
- 1/2 lyzeczki szafranu lub kurkumy\par
- 2 lyzki oliwy\par
- sol, pieprz, cytryna\par
\b Przygotowanie:\b0\par
1. Podsmaz cebule, papryke i czosnek na oliwie.\par
2. Dodaj ryz i chwile przesmaz.\par
3. Wlej bulion z szafranem/kurkuma i gotuj bez mieszania.\par
4. Pod koniec dodaj owoce morza i krewetki, gotuj do miekkosci ryzu.\par
\par
\b 11) Tzatziki (miseczka)\b0\par
\b Skladniki:\b0\par
- 300 g jogurtu greckiego\par
- 1/2 ogorka\par
- 1 zabek czosnku\par
- 1 lyzka oliwy\par
- 1 lyzka soku z cytryny\par
- koperek lub mieta\par
- sol i pieprz\par
\b Przygotowanie:\b0\par
1. Ogorka zetrzyj i odcisnij z nadmiaru wody.\par
2. Wymieszaj z jogurtem, czosnkiem, oliwa i cytryna.\par
3. Dopraw i schlodz 20-30 minut.\par
\par
\b 12) Skladniki do 10 przepisow (lista szybka)\b0\par
- warzywa: pomidory, ogorki, papryka, cebula, czosnek, baklazan, cukinia\par
- ziola: bazylia, oregano, pietruszka, koperek/mieta\par
- nabial: feta, jogurt grecki\par
- ryby/owoce morza: dorsz, krewetki, mieszanka owocow morza\par
- mieso: filet z kurczaka\par
- suche produkty: spaghetti, ryz do paelli, pieczywo, oliwki\par
- tluszcze i przyprawy: oliwa, cytryna, ocet winny, chili, sol, pieprz\par
\par
\b 13) Co mozna kupic w Lidlu i Biedronce (dla tych przepisow)\b0\par
\par
\b Lidl - zwykle dostepne\b0\par
- pomidory, ogorki, papryka, cebula, czosnek, cytryny\par
- baklazan, cukinia (sezonowo bardzo czesto)\par
- feta i jogurt grecki\par
- filety dorsza, krewetki (najczesciej mrozone), czasem mix owocow morza\par
- filet z kurczaka\par
- spaghetti, ryz, pieczywo typu bagietka/ciabatta\par
- oliwa extra virgin, oliwki, przyprawy\par
\par
\b Lidl - czesciej sezonowo lub w wybranych sklepach\b0\par
- szafran\par
- gotowe ryze do paelli\par
- swieze owoce morza (poza krewetkami)\par
- specjalistyczne sery regionalne\par
\par
\b Biedronka - zwykle dostepne\b0\par
- pomidory, ogorki, papryka, cebula, czosnek, cytryny\par
- baklazan, cukinia\par
- feta i jogurt grecki\par
- dorsz, krewetki mrozone, czasem mieszanki owocow morza\par
- filet z kurczaka\par
- makarony, ryz, pieczywo\par
- oliwa, oliwki, podstawowe przyprawy\par
\par
\b Biedronka - czesciej sezonowo lub w wybranych sklepach\b0\par
- szafran\par
- produkty premium z owocow morza\par
- niektore regionalne skladniki kuchni hiszpanskiej i wloskiej\par
\par
\b Trudniej dostepne w obu marketach\b0\par
- swieze mule i malze vongole\par
- osmiornica wysokiej jakosci\par
- bardzo swieze sardynki i dorada cala (zalezy od dostawy)\par
- niszowe sery i wedliny regionalne\par
\par
\b Najlatwiejsze dania do zrobienia z zakupow marketowych\b0\par
- salatka grecka\par
- bruschetta\par
- ratatouille\par
- dorsz pieczony z cytryna i oliwkami\par
- spaghetti aglio e olio z krewetkami\par
