# Skopiuj do .env lub ustaw w systemie (nie commituj sekretów).

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_RETRIES=3

# --- Pipeline: dodatkowe kontakty (monitorowany folder po głównym pliku) ---
# Puste = %USERPROFILE%\Documents\kontakty (Windows) lub ~/Documents/kontakty
# EXTRA_CONTACTS_DIR=C:\Users\svinc\Documents\kontakty

# --- run_pipeline.ps1 (tylko PowerShell): inny interpreter Python ---
# PIPELINE_PYTHON_EXE=C:\Users\svinc\AppData\Local\Programs\Python\Python313\python.exe

# --- Logi postępu (clean_validate_send_pipeline): co ile wierszy ---
# PIPELINE_PROGRESS_EVERY_N=50

# --- Excel (.xlsx / .xlsm / .xls): wiele arkuszy, tytuł nad tabelą ---
# Ile pierwszych wierszy przeszukać pod nagłówek kolumn (Lp., Firma, E-mail rekrutacyjny…)
# EXCEL_HEADER_SCAN_ROWS=35
# Wymuszony wiersz nagłówka: 0 = pierwszy wiersz pliku (np. 2 = trzeci wiersz jak w raportach)
# EXCEL_FORCE_HEADER_ROW=
# Dodatkowe arkusze do pominięcia (CSV, małe litery), oprócz Podsumowanie / summary itd.
# EXCEL_SKIP_SHEET_NAMES=

# --- SerpAPI (build_contacts_serpapi) ---
# W run_pipeline.ps1 wlaczony jest jeden pelny zbieg na dzien (plik .serpapi_last_run_date w folderze kontakty).
# SERPAPI_API_KEY=
# SERPAPI_RUN_STATE_PATH=   # opcjonalnie: inna sciezka pliku daty ostatniego sukcesu
# SERPAPI_DAILY_LIMIT_ENABLED=0   # wylacz limit (np. testy / reczne uruchomienia)
# SERPAPI_WEEKLY_REQUEST_LIMIT=200   # maksymalna liczba zapytan SerpAPI na tydzien (0 = bez limitu)
# SERPAPI_WEEKLY_STATE_PATH=   # opcjonalnie: inna sciezka pliku licznika tygodniowego

# --- CV (PDF): opcjonalnie CV_PATH = plik lub folder; bez tego szukane są wzorce CV*.pdf
# w %USERPROFILE%\Documents oraz w podfolderach CV, cv, Curriculum, Resume, resumes
# CV_PATH=C:\Users\svinc\Documents\CV

# --- Link do CV w treści generowanego maila (OpenAI). Brak zmiennej = domyślny publiczny link (Google Drive).
# Puste CV_DOWNLOAD_URL= — tylko załącznik PDF, bez linku w instrukcjach dla modelu.
# CV_DOWNLOAD_URL=https://drive.google.com/file/d/INNY_ID/view?usp=drive_link

# --- Gmail ---
# Hasło aplikacji (16 znaków bez spacji po sklejeniu) — to samo konto co nadawca.
GMAIL_APP_PASSWORD=
# Opcjonalnie: adres nadawcy SMTP (domyślnie wbudowany w contact_mailer); musi zgadzać się z kontem hasła aplikacji.
# GMAIL_SENDER_EMAIL=you@gmail.com

# --- Wysyłka ---
MAX_EMAILS_PER_DAY=200
MIN_DELAY_SECONDS=20
MAX_DELAY_SECONDS=90
SMTP_MAX_RETRIES=3
DRY_RUN=0

# --- Treść maila (jakość / długość) ---
MAIL_BODY_MIN_CHARS=400
MAIL_BODY_MIN_SENTENCES=4
MAIL_BODY_TEMPERATURE=0.55
MAIL_SIGNATORY_NAME=
MAIL_PROMPT_VERSION=

# --- Kontekst ze strony WWW (OpenAI) ---
ENABLE_WEB_PAGE_CONTEXT=0
WEB_FETCH_TIMEOUT=10
WEB_FETCH_MAX_BYTES=500000
WEB_FETCH_MAX_EXCERPT_CHARS=6000
WEB_FETCH_MIN_INTERVAL_SEC=1.5
WEB_FETCH_MIN_INTERVAL_PER_HOST_SEC=2
WEB_FETCH_NEGATIVE_CACHE_SEC=600
WEB_FETCH_HTTP_RETRIES=3
WEB_FETCH_USER_AGENT=

# --- E-mail ze strony (brak w komórce) ---
FETCH_EMAIL_FROM_WEBSITE=0
FETCH_EMAIL_TIMEOUT=8

# --- Blokada domen odbiorców ---
EMAIL_DOMAIN_BLOCKLIST_PATH=
EMAIL_DOMAIN_BLOCKLIST_RELOAD_SEC=30

# --- Alerty błędów (OpenAI+SMTP; próg 999 = praktycznie wyłączone) ---
ALERT_ON_ERROR_COUNT=999
ALERT_LOG_PATH=

# --- Rejestr wysłanych maili (JSON Lines, pod follow-up po kilku dniach) ---
# SENT_MAIL_REGISTRY_ENABLED=1
# Domyślny katalog: %USERPROFILE%\Documents\pipeline_logs\sent_mail_registry\<partia>.jsonl
# SENT_MAIL_REGISTRY_DIR=C:\Users\svinc\Documents\pipeline_logs\sent_mail_registry
# Usuwanie plików .jsonl, gdy najnowszy wpis sent_at jest starszy niż N dni (domyślnie 14); 0 = nigdy nie usuwaj
# SENT_MAIL_REGISTRY_RETENTION_DAYS=14
# Minimalny wiek follow-upu przy follow_up_mail.py list/export (domyślnie 7):
# FOLLOW_UP_MIN_DAYS=7

# --- Log kampanii ---
CAMPAIGN_LOG_ENABLED=1
CAMPAIGN_LOG_PATH=

# --- Logowanie Python (stdlib logging); domyślnie tylko stderr ---
# PIPELINE_LOG_LEVEL=INFO
# PIPELINE_LOG_TO_FILE=1
# PIPELINE_LOG_FILE=C:\Users\svinc\Documents\pipeline_logs\python_pipeline.log
# PIPELINE_LOG_MAX_BYTES=10485760
# PIPELINE_LOG_BACKUP_COUNT=5

# --- Kopie zapasowe DataFrame do JSON po każdym zapisie CSV/XLSX (wyłączone pod pytest) ---
# PIPELINE_JSON_BACKUP=1
# PIPELINE_JSON_BACKUP_DIR=
# PIPELINE_JSON_BACKUP_MAX_FILES=200
